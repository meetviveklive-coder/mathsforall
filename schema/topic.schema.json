{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topic.schema.json",
  "title": "Ganit topic file",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "version",
    "lesson",
    "practice",
    "quiz",
    "doubts"
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Markdown. Maths in $...$ (KaTeX). No raw HTML."
    },
    "verify": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "sympy",
            "relation",
            "manual"
          ]
        },
        "expr": {
          "type": "string",
          "description": "sympy: an expression whose value must equal the answer (or the correct option). relation: a SymPy relation/boolean that must evaluate to the answer true/false."
        },
        "reason": {
          "type": "string",
          "description": "manual only: why this cannot be computed."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "manual"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "sympy",
                  "relation"
                ]
              }
            }
          },
          "then": {
            "required": [
              "expr"
            ]
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "required": [
        "text",
        "correct"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "value": {
          "type": "string",
          "description": "Machine value for verification, e.g. '3/4'. Required when verify.kind is sympy."
        },
        "correct": {
          "type": "boolean"
        },
        "why_wrong": {
          "type": "string",
          "description": "Required for wrong options: the misconception and the fix."
        }
      },
      "if": {
        "properties": {
          "correct": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "why_wrong"
        ]
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "type",
        "prompt",
        "answer",
        "hints",
        "explanation",
        "verify"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s[0-8]-[a-z0-9-]+/[pqc]-[0-9]+$"
        },
        "type": {
          "enum": [
            "numeric",
            "mcq",
            "true_false",
            "text"
          ]
        },
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "description": "numeric: canonical value ('3/4', '1250'). mcq: text of correct option. true_false: 'true'|'false'. text: model answer."
        },
        "accept": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other accepted forms for text answers."
        },
        "hints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "explanation": {
          "$ref": "#/$defs/text"
        },
        "objective": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into the topic's objectives."
        },
        "visual": {
          "type": "string"
        },
        "verify": {
          "$ref": "#/$defs/verify"
        },
        "match": {
          "enum": [
            "value",
            "simplest",
            "exact",
            "mixed",
            "improper"
          ],
          "description": "How a typed numeric answer is accepted. value (default): any equal value. simplest: equal value AND in lowest terms. exact: same numerator and denominator as written in answer. mixed: equal value AND typed as a mixed number with a proper fraction part (e.g. 2 1/3), or as a whole number when the value is whole. improper: equal value AND typed as a single fraction a/b (not a mixed number)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "mcq"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          }
        }
      ]
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^s[0-8]-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "verified",
        "approved",
        "retired"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "lesson": {
      "type": "object",
      "required": [
        "hook",
        "sections",
        "examples"
      ],
      "additionalProperties": false,
      "properties": {
        "hook": {
          "$ref": "#/$defs/text"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "body"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string"
              },
              "body": {
                "$ref": "#/$defs/text"
              },
              "visual": {
                "type": "string"
              }
            }
          }
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "problem",
              "steps",
              "answer",
              "verify"
            ],
            "additionalProperties": false,
            "properties": {
              "problem": {
                "$ref": "#/$defs/text"
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/text"
                }
              },
              "answer": {
                "type": "string"
              },
              "verify": {
                "$ref": "#/$defs/verify"
              }
            }
          }
        },
        "summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "visuals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "alt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "spec": {
            "type": "string"
          },
          "alt": {
            "type": "string",
            "minLength": 10
          },
          "file": {
            "type": "string"
          },
          "checks": {
            "type": "object"
          }
        }
      }
    },
    "practice": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "doubts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "q",
          "a"
        ],
        "additionalProperties": false,
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "review": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "by",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
