{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topic-map.schema.json",
  "title": "Ganit topic map",
  "type": "object",
  "required": ["version", "stages", "topics"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "name"],
        "additionalProperties": false,
        "properties": {
          "stage": { "type": "integer", "minimum": 0, "maximum": 8 },
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "stage", "prerequisites", "objectives", "misconceptions", "est_minutes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-8]-[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 3, "maxLength": 80 },
          "stage": { "type": "integer", "minimum": 0, "maximum": 8 },
          "unit": { "type": "string" },
          "prerequisites": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "objectives": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "minLength": 10 } },
          "misconceptions": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 10 } },
          "est_minutes": { "type": "integer", "minimum": 10, "maximum": 60 },
          "indian_context": { "type": "string" }
        }
      }
    }
  }
}
